        <mxCell id="v116" value="&lt;font style=&quot;font-size:16px;font-family:Arial;color:#000000&quot;&gt;health check&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="2282" y="1581" width="600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="l117" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5282FF;strokeWidth=2;" edge="1" parent="1">
