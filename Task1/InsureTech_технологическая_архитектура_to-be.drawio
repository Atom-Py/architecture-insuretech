            <mxPoint x="2210" y="1621" as="sourcePoint" />
            <mxPoint x="2270" y="1621" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v118" value="&lt;font style=&quot;font-size:16px;font-family:Arial;color:#000000&quot;&gt;репликация и резервное копирование&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="2282" y="1609" width="600" height="24" as="geometry" />
        </mxCell>
