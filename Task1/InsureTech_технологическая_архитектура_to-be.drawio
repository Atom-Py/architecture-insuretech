        </mxCell>
        <mxCell id="e105-l" value="WAL-G" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontColor=#1F4FCC;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e105">
          <mxGeometry x="-0.25" y="0" relative="1" as="geometry">
